#!/bin/bash
# ==========================================================
#  התקנת התלויות עבור כלי מספור אלבום התמונות (Mac)
#  יש ללחוץ פעמיים על הקובץ הזה כדי להתקין.
# ==========================================================

# עוברים לתיקייה שבה נמצא הסקריפט (תומך ברווחים ובעברית בנתיב)
cd "$(dirname "$0")" || exit 1

echo "======================================================"
echo "  התקנת הכלי לעיבוד אלבומי תמונות"
echo "======================================================"
echo ""

# מאתרים Python 3
if command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    echo "❌ לא נמצאה התקנה של Python 3 במחשב."
    echo ""
    echo "התקיני Python 3.11 ומעלה מהכתובת:"
    echo "    https://www.python.org/downloads/macos/"
    echo ""
    echo "לאחר ההתקנה הפעילי את הקובץ הזה שוב."
    echo ""
    read -n 1 -s -r -p "לחצי על מקש כלשהו לסגירה..."
    exit 1
fi

echo "נמצא Python:"
$PY --version
echo ""
echo "מתקינים את הספריות הנדרשות (עשוי לקחת מספר דקות)..."
echo ""

# משדרגים pip ומתקינים את התלויות עבור המשתמשת
$PY -m pip install --upgrade pip
$PY -m pip install --user -r requirements.txt

if [ $? -eq 0 ]; then
    echo ""
    echo "======================================================"
    echo "  ✅ ההתקנה הושלמה בהצלחה!"
    echo "======================================================"
    echo ""
    echo "כעת אפשר להפעיל את הכלי בלחיצה כפולה על:"
    echo "    run_app.command"
    echo ""
else
    echo ""
    echo "❌ ההתקנה נכשלה. נסי שוב, או פני לעזרה."
    echo ""
fi

read -n 1 -s -r -p "לחצי על מקש כלשהו לסגירה..."
echo ""
