#!/bin/bash
# ==========================================================
#  הפעלת הממשק הגרפי של כלי מספור אלבום התמונות (Mac)
#  יש ללחוץ פעמיים על הקובץ הזה כדי לפתוח את התוכנה.
# ==========================================================

# עוברים לתיקייה שבה נמצא הסקריפט (תומך ברווחים ובעברית בנתיב)
cd "$(dirname "$0")" || exit 1

if command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    echo "❌ לא נמצאה התקנה של Python 3."
    echo "הריצי תחילה את install_mac.command"
    read -n 1 -s -r -p "לחצי על מקש כלשהו לסגירה..."
    exit 1
fi

# פותחים את הממשק הגרפי
$PY album_gui.py

# אם קרתה שגיאה – משאירים את החלון פתוח כדי שנראה אותה
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ אירעה שגיאה בהפעלת הממשק."
    echo "אם זו הפעם הראשונה, ודאי שהרצת את install_mac.command."
    read -n 1 -s -r -p "לחצי על מקש כלשהו לסגירה..."
fi
